# Comma-separated IPv4 addresses expected for tenant custom domains.
ARTSFOLIO_EXPECTED_IPV4=127.0.0.1

# Email delivery
EMAIL_DRIVER=dry_run
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM_EMAIL=no-reply@artsfol.io
MAIL_FROM_NAME=ArtsFolio

# Instagram publishing via Meta Instagram API with Instagram Login.
# Each tenant configures its own Meta App ID and App Secret in Tenant Admin.
# Register this exact callback URL in every tenant-owned Meta app.
ARTSFOLIO_INSTAGRAM_REDIRECT_URI=https://artsfol.io/social/instagram/callback

# Generate the token key with:
# php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Generate a distinct state-signing key with:
# openssl rand -hex 32
ARTSFOLIO_SOCIAL_TOKEN_KEY=
ARTSFOLIO_SOCIAL_STATE_KEY=

# End of file.
